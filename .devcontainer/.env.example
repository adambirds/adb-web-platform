# Development Environment Variables for DevContainer
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control - it contains sensitive information

CACHE_BACKEND_URL=redis://redis-cache:6379/0
DEBUG=1
DEBUG_TOOLBAR_ENABLED=0
FRONTEND_URL=http://localhost:5173
SECRET_KEY=some-very-secret-key
SESSION_BACKEND_URL=redis://redis-session:6379/0
SITE_DOMAIN=localhost
SQL_DATABASE=app_dev
SQL_ENGINE=django.db.backends.postgresql
SQL_HOST=db
SQL_PASSWORD=app_dev_password
SQL_PORT=5432
SQL_USER=app

